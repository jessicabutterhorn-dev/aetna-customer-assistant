# Anthropic API key — required for all LLM calls
# Get one at https://console.anthropic.com
ANTHROPIC_API_KEY=

# Optional: override the model. Defaults to claude-haiku-4-5-20251001
# Other options: claude-sonnet-4-6, claude-opus-4-6 (matches PRD)
# MODEL_ID=claude-haiku-4-5-20251001

# Optional: override knowledge-base directory path (defaults to ./knowledge-base)
# KB_PATH=/path/to/knowledge-base
