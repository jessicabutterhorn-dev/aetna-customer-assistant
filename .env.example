# ── PRIMARY PROVIDER ──────────────────────────────────────────────────────────
# Anthropic — required when INFERENCE_PROVIDER=anthropic (default)
# Get key at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# ── FAILOVER PROVIDERS ────────────────────────────────────────────────────────
# Cerebras — first failover when Anthropic fails
# Get key at https://cloud.cerebras.ai
CEREBRAS_API_KEY=csk-...

# Groq — last-resort failover
# Get key at https://console.groq.com
GROQ_API_KEY=gsk-...

# ── OPTIONAL OVERRIDES ────────────────────────────────────────────────────────
# Which provider to use. Defaults to "anthropic". Options: anthropic | cerebras | groq
# Set to "cerebras" to bypass Anthropic entirely (e.g., for local testing without Anthropic key)
# INFERENCE_PROVIDER=anthropic

# Override model ID (defaults per provider: claude-sonnet-4-6 / llama3.1-8b / llama-3.3-70b-versatile)
# MODEL_ID=claude-sonnet-4-6

# Override knowledge-base directory (defaults to ./knowledge-base)
# KB_PATH=/path/to/knowledge-base
